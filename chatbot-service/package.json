{
  "name": "healthcare-chatbot-service",
  "version": "1.0.0",
  "description": "Healthcare AI Chatbot Service",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "node server.js",
    "start:python": "python src/services/chat_runner.py",
    "start:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd frontend && npm install && pip install -r requirements.txt",
    "build": "cd frontend && npm run build",
    "dev": "concurrently \"npm run start:python\" \"npm run start:backend\" \"npm run start:frontend\"",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "axios": "^1.12.2",
    "ws": "^8.18.3",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^6.0.0",
    "@huggingface/inference": "^4.9.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
